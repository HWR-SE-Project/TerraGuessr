# Copy to frontend/.env.local, then restart Vite / rebuild production assets.
# Public browser key: Maps JavaScript API only, restricted by HTTP referrers.
# Allow local dev http://127.0.0.1:5173/* and/or http://localhost:5173/*,
# plus your exact production origin. Billing must be active on the Cloud project.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Defaults use Vite's /api proxy and existing weather map provider.
VITE_API_BASE_URL=/api
# Local backend proxy target; shell values take priority.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3005
# Legacy weather games only; Street View gameplay uses Google Maps throughout.
# VITE_TILE_URL=
# VITE_MAP_ATTRIBUTION=
