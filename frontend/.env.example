# Optional. Defaults use Vite's /api proxy and Esri World Street Map tiles (English labels) for Leaflet.
VITE_API_BASE_URL=/api
# VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}

# Optional override. By default the dev server proxies /api to
# http://localhost:<BACKEND_HOST_PORT>, read from the root .env (3000 unless
# you changed it). Leave this unset so changing BACKEND_HOST_PORT once updates
# the frontend automatically.
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000
