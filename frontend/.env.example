# Copy to frontend/.env.local, then restart Vite / rebuild production assets.
# Public browser key: Maps JavaScript API only, restricted by HTTP referrers.
# Allow local dev http://localhost:8080/*, plus your exact production origin.
# Billing must be active on the Cloud project.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. Defaults use Vite's /api proxy and existing weather map provider.
VITE_API_BASE_URL=/api

# Optional override. By default the dev server proxies /api to
# http://localhost:<BACKEND_HOST_PORT>, read from the root .env (3000 unless
# you changed it). Leave this unset so changing BACKEND_HOST_PORT once updates
# the frontend automatically.
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# Legacy weather games only; Street View gameplay uses Google Maps throughout.
# VITE_TILE_URL=
# VITE_MAP_ATTRIBUTION=
