{
  "name": "terraguessr-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --exclude '**/integration/**'",
    "lint": "eslint .",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "db:seed": "tsx prisma/seed.ts",
    "db:init": "prisma migrate deploy && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@prisma/client": "5.22.0",
    "@sinclair/typebox": "^0.34.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^11.3.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true
  }
}
