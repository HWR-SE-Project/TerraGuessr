// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Region {
  AFRICA
  EUROPE
  ASIA
  NORTH_AMERICA
  SOUTH_AMERICA
  OCEANIA
}

enum GameMode {
  solo
  challenge
}

enum AdditionalDataUnlockMode {
  immediate
  time
  points
}

enum Difficulty {
  easy
  medium
  hard
}

enum GameStatus {
  active
  completed
}

enum RoundStatus {
  active
  completed
}

enum LobbyStatus {
  waiting
  playing
  finished
}

enum LocationSrc {
  grid
  city
}

enum WeatherSrc {
  open_meteo
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String?
  googleSub       String?              @unique
  displayName     String
  emailVerifiedAt DateTime?
  failedLoginAttempts Int              @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  sessions        AuthSession[]
  resetTokens     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  emailChangeRequests EmailChangeRequest[]
  preferences     UserPreference?
  games           Game[]
  dailySubmissions DailySubmission[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now OR lastUsedAt <= cutoff`.
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now`.
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now`.
  @@index([expiresAt])
}

// A pending address change. Both inboxes must confirm before `User.email`
// moves, so the current owner can veto and the new address is proven.
model EmailChangeRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldEmail       String
  newEmail       String
  oldTokenHash   String    @unique
  newTokenHash   String    @unique
  oldConfirmedAt DateTime?
  newConfirmedAt DateTime?
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now OR completedAt IS NOT NULL`.
  @@index([expiresAt])
}

model UserPreference {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language      String   @default("en")
  soundFxVolume Int      @default(50)
  musicVolume   Int      @default(35)
  fullscreen    Boolean  @default(false)
  avatarConfig  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DailyChallenge {
  date              String             @id @db.VarChar(10)
  locationId        String
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  weatherSnapshotId String
  weatherSnapshot   WeatherSnapshot    @relation(fields: [weatherSnapshotId], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now())
  submissions       DailySubmission[]
}

model DailySubmission {
  id         String         @id @default(cuid())
  date       String         @db.VarChar(10)
  challenge  DailyChallenge @relation(fields: [date], references: [date], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guessLat   Float
  guessLon   Float
  distanceKm Float
  score      Int
  createdAt  DateTime       @default(now())

  @@unique([date, userId])
  @@index([date, score, distanceKm])
  @@index([userId, date])
}

model Location {
  id        String            @id @default(cuid())
  lat       Float
  lon       Float
  name      String?
  region    Region
  isLand    Boolean           @default(true)
  source    LocationSrc       @default(grid)
  createdAt DateTime          @default(now())
  snapshots WeatherSnapshot[]
  rounds    Round[]
  dailyChallenges DailyChallenge[]

  @@index([region])
}

model WeatherSnapshot {
  id              String     @id @default(cuid())
  locationId      String
  location        Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fetchedAt       DateTime   @default(now())
  temperatureC    Float // R03 mandatory
  precipitationMm Float // R03 mandatory
  humidityPct     Float // R03 mandatory
  windSpeedKmh    Float // R03 mandatory
  airPressureHpa  Float?
  windDirectionDeg Float?
  uvIndex         Float?
  sunshineDurationSeconds Float?
  localTime       String?
  extra           Json? // decision B.2: optional, never required
  source          WeatherSrc @default(open_meteo)
  rounds          Round[]
  dailyChallenges DailyChallenge[]

  @@index([locationId, fetchedAt]) // drives <=1h staleness lookup (B.11)
}

model Game {
  id                    String     @id @default(cuid())
  mode                  GameMode
  difficulty            Difficulty
  status                GameStatus @default(active)
  roundsTotal           Int        @default(5)
  attemptsPerRound      Int        @default(1)
  geoRegion             Region?
  candidateCount        Int?
  additionalDataUnlockMode AdditionalDataUnlockMode @default(immediate)
  additionalDataUnlockCost Int?
  playerTokenHash       String // sha256(rawToken), ADR-0011
  nextLocationId        String? // prefetched next round (R12)
  nextWeatherSnapshotId String?
  ownerUserId           String?
  owner                 User?      @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime   @default(now())
  rounds                Round[]

  @@index([playerTokenHash])
  @@index([ownerUserId, createdAt])
}

model Round {
  id                String          @id @default(cuid())
  gameId            String
  game              Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location        @relation(fields: [locationId], references: [id])
  weatherSnapshotId String
  weatherSnapshot   WeatherSnapshot @relation(fields: [weatherSnapshotId], references: [id])
  roundNumber       Int
  difficulty        Difficulty
  selectionMode     String // 'map' | 'list'
  status            RoundStatus     @default(active)
  startedAt         DateTime        @default(now())
  additionalDataAvailableAt DateTime?
  additionalDataUnlockedAt DateTime?
  additionalDataPointsSpent Int @default(0)
  completedAt       DateTime?
  guess             Guess?
  attempts          RoundAttempt[]
  result            Result?
  challenge         Challenge?

  @@unique([gameId, roundNumber])
  @@index([gameId, status])
}

model Guess {
  id          String   @id @default(cuid())
  roundId     String   @unique // one guess per round (R08)
  round       Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  lat         Float
  lon         Float
  submittedAt DateTime @default(now())
}

model RoundAttempt {
  id          String   @id @default(cuid())
  roundId     String
  round       Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  attemptNumber Int
  guessLat    Float
  guessLon    Float
  distanceKm  Float
  score       Int
  createdAt   DateTime @default(now())

  @@unique([roundId, attemptNumber])
  @@index([roundId, score, distanceKm])
}

model Result {
  id         String           @id @default(cuid())
  roundId    String           @unique
  round      Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  actualLat  Float
  actualLon  Float
  guessLat   Float
  guessLon   Float
  distanceKm Float // R09
  score      Int // R10
  createdAt  DateTime         @default(now()) // drives 6-month purge (R18)
  entries    ChallengeEntry[]

  @@index([createdAt]) // purge scan
}

model Challenge {
  id        String           @id @default(cuid())
  roundId   String           @unique // the shared fixed round/location (B.3)
  round     Round            @relation(fields: [roundId], references: [id], map: "Challenge_round_fkey")
  createdAt DateTime         @default(now())
  expiresAt DateTime?
  entries   ChallengeEntry[]
}

model ChallengeEntry {
  id              String    @id @default(cuid())
  challengeId     String
  challenge       Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  resultId        String
  result          Result    @relation(fields: [resultId], references: [id], onDelete: Cascade)
  displayName     String? // no account (B.6)
  playerTokenHash String // sha256(rawToken), ADR-0011 — one entry per player per challenge (P0-3)

  @@unique([challengeId, resultId])
  @@unique([challengeId, playerTokenHash])
  @@index([challengeId])
}

// Pre-game multiplayer waiting room (R16). A lobby only stores membership and
// the host's difficulty choice; it deliberately owns no round/location logic.
model Lobby {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(6)
  difficulty    Difficulty
  hostTokenHash String // sha256(rawToken), ADR-0011
  maxPlayers    Int           @default(8)
  roundsTotal   Int           @default(5)
  status        LobbyStatus   @default(waiting)
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  members       LobbyMember[]

  @@index([expiresAt])
  @@index([status])
}

model LobbyMember {
  id              String   @id @default(cuid())
  lobbyId         String
  lobby           Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  playerTokenHash String // sha256(rawToken), ADR-0011
  displayName     String?
  joinedAt        DateTime @default(now())

  @@unique([lobbyId, playerTokenHash])
  @@index([lobbyId])
}

// Street View is isolated from the existing weather game contracts.
//
// Session lifecycle (endless mode): a row is Created at POST .../games, then
// Active for as long as it exists with no fixed round limit — each round
// transitions briefly through "round completed" (score set, no activeRound
// yet) before the next POST .../rounds starts the next one. A row is Ended
// the moment the player explicitly finalizes it (DELETE .../games/:id,
// triggered by the "End Game" confirmation) — already-scored rounds survive
// independently in StreetResult (R18), but the StreetGame row itself is gone,
// so `owned()` 404s forever after and the session can never be reactivated.
// Abandoned covers the same DELETE outcome reached a different way: the 24h
// expiry sweep (`expiresAt`-driven) removing a row nobody explicitly ended —
// e.g. a refresh, tab close, or crash mid-game. Both are a hard delete; there
// is deliberately no soft "ended" flag to resurrect, and the frontend never
// persists credentials across a reload, so neither path is ever resumable.
model StreetGame {
  id              String        @id @default(cuid())
  playerTokenHash String
  difficulty      Difficulty    @default(medium) // R05
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  rounds          StreetRound[]

  // Prefetched next-round target (R12). Best-effort cache, consumed
  // atomically by the next POST .../rounds call; never a correctness
  // dependency (routes.ts falls back to synchronous selection).
  nextTargetIndex Int?
  nextPanoId      String?
  nextTargetLat   Float?
  nextTargetLon   Float?

  @@index([expiresAt])
}

model StreetRound {
  id          String     @id @default(cuid())
  gameId      String
  game        StreetGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  number      Int
  panoId      String
  targetIndex Int
  targetLat   Float
  targetLon   Float
  // Easy-mode candidate list shown for this round (R07), persisted so a
  // resumed session redisplays the same options instead of re-rolling them.
  candidatesJson Json?
  guessLat    Float?
  guessLon    Float?
  distanceKm  Float?
  score       Int?
  createdAt   DateTime   @default(now())

  @@unique([gameId, number])
}

// Durable archive of a completed Street View round (R18). Written once, at
// guess-lock time, from values already resolved for scoring — never a second
// provider/weather call. Deliberately has NO relation/cascade to StreetGame or
// StreetRound: the 24h session-expiry cleanup (routes.ts) only prunes
// resumable session state, and must never touch this archival record. Purged
// by its own 6-month retention job (scheduler/purge.ts), independent of
// session expiry.
model StreetResult {
  id          String     @id @default(cuid())
  gameId      String
  roundId     String     @unique
  roundNumber Int
  difficulty  Difficulty
  actualLat   Float
  actualLon   Float
  guessLat    Float
  guessLon    Float
  distanceKm  Float // R09
  score       Int // R10
  createdAt   DateTime   @default(now()) // drives 6-month purge (R18)

  @@index([createdAt])
}
