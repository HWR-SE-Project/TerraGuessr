// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  easy
  medium
  hard
}

enum GameMode {
  solo
  multiplayer
}

enum LobbyStatus {
  waiting
  playing
  finished
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  passwordHash        String?
  googleSub           String?                  @unique
  displayName         String
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int                      @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sessions            AuthSession[]
  resetTokens         PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  emailChangeRequests EmailChangeRequest[]
  preferences         UserPreference?
  streetGames         StreetGame[]
  lobbyMembers        LobbyMember[]
  gameResults         GameResult[]
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now OR lastUsedAt <= cutoff`.
  @@index([expiresAt])
  @@index([lastUsedAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now`.
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now`.
  @@index([expiresAt])
}

// A pending address change. Both inboxes must confirm before `User.email`
// moves, so the current owner can veto and the new address is proven.
model EmailChangeRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldEmail       String
  newEmail       String
  oldTokenHash   String    @unique
  newTokenHash   String    @unique
  oldConfirmedAt DateTime?
  newConfirmedAt DateTime?
  completedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([userId, expiresAt])
  // Backs authCleanup.ts's unscoped `WHERE expiresAt <= now OR completedAt IS NOT NULL`.
  @@index([expiresAt])
  @@index([completedAt])
}

model UserPreference {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language      String   @default("en")
  soundFxVolume Int      @default(50)
  musicVolume   Int      @default(35)
  fullscreen    Boolean  @default(false)
  avatarConfig  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Pre-game multiplayer waiting room (R16). A lobby only stores membership and
// the host's difficulty choice; it deliberately owns no round/location logic.
model Lobby {
  id            String        @id @default(cuid())
  code          String        @unique @db.VarChar(6)
  difficulty    Difficulty
  // Rotated at the start of each match/rematch so archived rounds can be
  // grouped into the exact game they belonged to.
  matchId       String        @default(cuid())
  hostTokenHash String // sha256(rawToken), ADR-0011
  roundsTotal   Int           @default(5)
  status        LobbyStatus   @default(waiting)
  currentRound  Int           @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  expiresAt     DateTime
  members       LobbyMember[]
  rounds        LobbyRound[]

  @@index([expiresAt])
  @@index([status])
}

model LobbyMember {
  id                  String              @id @default(cuid())
  lobbyId             String
  lobby               Lobby               @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  // Captured once when the member creates/joins the lobby; guests stay null.
  userId              String?
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  playerTokenHash     String // sha256(rawToken), ADR-0011
  displayName         String?
  selectionLat        Float?
  selectionLon        Float?
  // Set when this player chooses to continue after a finished match.
  continueRequestedAt DateTime?
  joinedAt            DateTime            @default(now())
  attempts            LobbyRoundAttempt[]
  results             LobbyRoundResult[]
  roundStates         LobbyRoundMemberState[]

  @@unique([lobbyId, playerTokenHash])
  @@index([userId])
}

model LobbyRound {
  id             String              @id @default(cuid())
  lobbyId        String
  lobby          Lobby               @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  number         Int
  panoId                  String
  targetIndex             Int
  targetLat               Float
  targetLon               Float
  placeName               String?
  sceneJson               Json?
  candidatesJson Json?
  startedAt               DateTime?
  endsAt                  DateTime?
  reviewEndsAt            DateTime?
  weatherValidUntil       DateTime?
  weatherAttemptedIndices Int[]               @default([])
  weatherExhausted        Boolean             @default(false)
  createdAt               DateTime            @default(now())
  attempts       LobbyRoundAttempt[]
  results        LobbyRoundResult[]
  memberStates   LobbyRoundMemberState[]

  @@unique([lobbyId, number])
}

model LobbyRoundAttempt {
  id            String      @id @default(cuid())
  roundId       String
  round         LobbyRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  memberId      String
  member        LobbyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attemptNumber Int
  guessLat      Float
  guessLon      Float
  distanceKm    Float
  score         Int
  createdAt     DateTime    @default(now())

  @@unique([roundId, memberId, attemptNumber])
  @@index([memberId])
}

model LobbyRoundResult {
  id           String      @id @default(cuid())
  roundId      String
  round        LobbyRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  memberId     String
  member       LobbyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  actualLat    Float?
  actualLon    Float?
  guessLat     Float?
  guessLon     Float?
  distanceKm   Float?
  score        Int
  attemptsUsed Int
  extraDataPointsSpent Int @default(0)
  createdAt    DateTime    @default(now())

  @@unique([roundId, memberId])
  @@index([memberId])
}

// Per-player state for the active round. Keeps additional-data unlocks and
// hard-mode time penalties local to the player who chose them (R05/R16).
model LobbyRoundMemberState {
  id                   String      @id @default(cuid())
  roundId              String
  round                LobbyRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  memberId             String
  member               LobbyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  extraDataUnlockedAt  DateTime?
  extraDataPointsSpent Int         @default(0)
  // Overrides the shared round deadline after a hard-mode time penalty.
  endsAt               DateTime?
  // Set when this player clicks Continue during the shared round review (R16).
  reviewReadyAt        DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([roundId, memberId])
  @@index([roundId])
  @@index([memberId])
}

// Street View is isolated from the existing weather game contracts.
//
// Session lifecycle: a row is Created at POST .../games with either a finite
// `roundsTotal` (3..10, matching multiplayer) or `roundsTotal = null` for
// endless mode. Each round transitions briefly through "round completed"
// (score set, no activeRound yet) before the next POST .../rounds starts the
// next one, until either `roundsTotal` rounds are completed (finite mode) or
// the player explicitly finalizes it (DELETE .../games/:id). Already-scored
// rounds survive independently in GameResult for signed-in players (R18), while
// DELETE removes the StreetGame row so `owned()` 404s forever after.
// Abandoned covers the same DELETE outcome via the 24h expiry sweep.
model StreetGame {
  id              String        @id @default(cuid())
  playerTokenHash String
  // Captured once at creation; guests stay null (R18 archives only accounts).
  ownerUserId     String?
  owner           User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  difficulty      Difficulty    @default(medium) // R05
  // Null = endless mode (no round cap); 3..10 = fixed-length game matching multiplayer.
  roundsTotal     Int?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  rounds          StreetRound[]

  // Prefetched next-round preparation record (R12/R13). One preparation
  // record per upcoming round number, sharing the 3-location weather budget
  // across background prefetch, revalidation, and foreground POST .../rounds.
  nextRoundNumber       Int?
  nextTargetIndex       Int?
  nextPanoId            String?
  nextTargetLat         Float?
  nextTargetLon         Float?
  nextSceneJson         Json?
  nextWeatherValidUntil DateTime?
  nextAttemptedIndices  Int[]     @default([])
  nextExhausted         Boolean   @default(false)

  @@index([expiresAt])
  @@index([ownerUserId])
}

model StreetRound {
  id             String     @id @default(cuid())
  gameId         String
  game           StreetGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  number         Int
  panoId                  String
  targetIndex             Int
  targetLat               Float
  targetLon               Float
  placeName               String?
  sceneJson               Json?
  // Easy-mode candidate list shown for this round (R07), persisted so a
  // resumed session redisplays the same options instead of re-rolling them.
  candidatesJson Json?
  // R05/R08 round timer and the player's latest (not yet submitted) selection.
  // The selection is what a timeout evaluates when no attempt was submitted.
  startedAt      DateTime?
  endsAt         DateTime?
  selectionLat   Float?
  selectionLon   Float?
  // R05 additional-data unlock state, server-authoritative.
  additionalDataUnlockedAt DateTime?
  additionalDataPointsSpent Int      @default(0)
  guessLat       Float?
  guessLon       Float?
  distanceKm     Float?
  score          Int?
  createdAt      DateTime   @default(now())
  attempts       StreetRoundAttempt[]

  @@unique([gameId, number])
  @@index([endsAt])
}

// R02: every submitted singleplayer guess, including non-final attempts.
model StreetRoundAttempt {
  id            String      @id @default(cuid())
  roundId       String
  round         StreetRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  attemptNumber Int
  guessLat      Float
  guessLon      Float
  distanceKm    Float
  score         Int
  createdAt     DateTime    @default(now())

  @@unique([roundId, attemptNumber])
}

// Durable archive of a completed round for a signed-in player (R18). Guest
// rounds are intentionally not archived because the requirement ties retention
// to the player's account. `id` is a deterministic dedupe key:
//   solo:<StreetRound.id> | lobby:<LobbyRoundResult.id>
// Deliberately has NO relation/cascade to StreetGame, StreetRound, Lobby, or
// LobbyMember: session/lobby cleanup must never delete retained history.
// Deleting a user account immediately cascades their GameResult rows, while
// active accounts' rows are automatically purged after 6 months (scheduler/purge.ts).
// `sessionId` + `roundNumber` allow archived rounds to be regrouped per game.
model GameResult {
  id                   String     @id
  userId               String?
  user                 User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode                 GameMode
  difficulty           Difficulty
  sessionId            String // StreetGame.id or Lobby.id, no FK by design
  matchId              String // groups rounds of one game; rotates on lobby rematch
  roundNumber          Int
  actualLat            Float
  actualLon            Float
  guessLat             Float? // last submitted attempt; null when the round ended without one
  guessLon             Float?
  distanceKm           Float? // R09
  score                Int // R10
  placeName            String?
  biome                String?
  weather              String?
  temperatureBand      String?
  attemptsUsed         Int?
  extraDataUnlocked    Boolean?
  extraDataPointsSpent Int?
  elapsedSeconds       Int?
  matchPlacement       Int? // 1-based final rank in completed multiplayer matches
  matchPlayerCount     Int? // total players in completed multiplayer matches
  createdAt            DateTime   @default(now()) // drives 6-month purge (R18)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, matchId, createdAt])
  @@index([sessionId])
  @@index([matchId])
}
