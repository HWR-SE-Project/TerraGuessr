# Host-side backend overrides for `npm run dev:host`.
#
# The backend runs directly on your machine while Postgres + Mailpit stay in
# Docker. The main ../.env targets the compose network, where Mailpit is
# reachable as `mailpit:1025`; from the host it is published on
# MAILPIT_SMTP_PORT from ../.env (1125 by default).
#
# Also used for the non-production SMTP check: without these values the backend
# auto-verifies accounts and never renders the verification email.
SMTP_URL=smtp://localhost:1125
SMTP_FROM="TerraGuessr <no-reply@terraguessr.local>"
