# =============================================================================
# TerraGuessr — environment configuration (architecture.md §10 / R19)
# =============================================================================
# This is the authoritative list of environment variables. Copy to .env and
# adjust as needed. .env is gitignored and must never be committed — no real
# secrets belong here or in the repository.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (runtime)
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
#   * Local dev (backend running directly on your host): use "localhost".
#   * docker compose overrides the host to "postgres" automatically, so the
#     value below is only used when the backend runs outside of compose.
DATABASE_URL=postgresql://terraguessr:terraguessr@localhost:5432/terraguessr

# HTTP port the Fastify server listens on (default 3000).
PORT=3000

# Allowed browser origin for CORS. Keep it equal to the frontend URL.
# Local development uses http://localhost:8080 everywhere (see README).
CORS_ORIGIN=http://localhost:8080

# Trust X-Forwarded-* headers from a reverse proxy so rate limits and
# same-site checks see the real client IP/origin. Accepts true/false, a hop
# count, or a proxy-addr CIDR list. Keep false when the backend is reachable
# directly; docker-compose.prod.yml sets 1 (one Caddy hop) automatically.
TRUST_PROXY=false

# Open-Meteo base URL (default https://api.open-meteo.com).
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Geographic intelligence: free endpoint for non-commercial evaluation only.
# Commercial deployments: set base URL to https://customer-api.open-meteo.com
# and provide a server-only subscription key. Never use a VITE_ variable.
OPEN_METEO_API_KEY=

# Fastify log level: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=info

# Optional account integrations. Leave blank until real provider credentials
# and callback URLs have been created by the operator.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
APP_BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false

# Email verification + password recovery SMTP.
# Local dev (`docker-compose.yml`): leave both blank to use the bundled Mailpit
# test inbox at http://localhost:8025 (messages never leave the host).
# Production (`docker-compose.prod.yml`): BOTH variables are required; compose
# fails fast when either is missing. To test with Mailpit in prod compose,
# enable `--profile test-mail` explicitly and point SMTP_URL at smtp://mailpit:1025.
# For real delivery set both to your provider, e.g.
#   SMTP_URL=smtps://resend:re_key@smtp.resend.com:465
#   SMTP_FROM=TerraGuessr <no-reply@yourdomain.com>
# Only .env changes are needed to switch; no rebuild of the app.
# If you run the backend on the host instead of in compose, use
# SMTP_URL=smtp://localhost:1025 to reach the same Mailpit inbox.
# APP_BASE_URL (above) must be the public frontend origin; the verify link
# points at <APP_BASE_URL>/verify-email?token=...
# Never commit real credentials.
SMTP_URL=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Frontend build (Vite inlines these at build time; rebuild to change)
# -----------------------------------------------------------------------------
# Keep same-origin behind Caddy.
VITE_API_BASE_URL=/api
# Optional Leaflet raster tile template override (defaults to CARTO Voyager).
VITE_MAP_TILE_URL=
# Optional map attribution override.
VITE_MAP_ATTRIBUTION=

# When running the frontend with Vite locally, values live in
# frontend/.env.local instead (see frontend/.env.example). Vite reads this
# root .env too, so BACKEND_HOST_PORT below automatically drives the /api
# proxy target; no separate frontend URL needs to be kept in sync.

# -----------------------------------------------------------------------------
# Docker Compose (used for ${VAR} interpolation below; keep in sync with
# DATABASE_URL above)
# -----------------------------------------------------------------------------

POSTGRES_USER=terraguessr
POSTGRES_PASSWORD=terraguessr
POSTGRES_DB=terraguessr
# Host port the Postgres container is published on.
POSTGRES_PORT=5432
# Host port the backend is published on; the container still listens on PORT.
# Set this to another free port if 3000 is occupied on your Mac. The Vite dev
# proxy picks this value up automatically.
BACKEND_HOST_PORT=3000
# Mailpit test SMTP inbox (local compose publishes both on localhost; prod
# exposes the UI on 127.0.0.1 only so it is reachable via an SSH tunnel).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# Production reverse proxy (docker-compose.prod.yml / Caddyfile, R17)
# -----------------------------------------------------------------------------
# Public hostname Caddy serves. Placeholder only — set the real domain at
# deploy time, and only after PO approval (decision B.7).
DOMAIN=terraguessr.example.com
# Contact address for Let's Encrypt certificate notifications.
ACME_EMAIL=admin@example.com
